FROM php:fpm-alpine

USER root

COPY --from=composer:latest /usr/bin/composer /usr/local/bin/composer
COPY --from=ghcr.io/php/pie:bin /pie /usr/local/bin/pie

RUN apk add --no-cache \
        $PHPIZE_DEPS \
        freetype-dev \
        gifsicle \
        git \
        jpegoptim \
        libjpeg-turbo-dev \
        libpng-dev \
        libtool \
        libwebp-dev \
        libzip-dev \
        oniguruma-dev \
        optipng \
        pngquant \
        unzip \
        zlib-dev && \
    docker-php-ext-configure gd --with-freetype --with-jpeg --with-webp && \
    docker-php-ext-install -j$(nproc) bcmath gd mbstring pdo_mysql zip && \
    pie install --no-interaction phpredis/phpredis:dev-develop && \
    printf '%s\n\n%s\n' '#!/bin/sh' 'exec php artisan "$@"' > /usr/local/bin/artisan && \
    printf '%s\n\n%s\n' '#!/bin/sh' 'exec php artisan test "$@"' > /usr/local/bin/ptest && \
    printf '%s\n\n%s\n' '#!/bin/sh' 'exec php artisan test --filter "$@"' > /usr/local/bin/ptfltrd && \
    chmod +x /usr/local/bin/artisan /usr/local/bin/ptest /usr/local/bin/ptfltrd && \
    addgroup -g 1000 laravel && \
    adduser -u 1000 -D -S -G laravel laravel && \
    chown laravel:laravel /var/www/html

USER laravel

WORKDIR /var/www/html
