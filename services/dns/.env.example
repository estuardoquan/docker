COMPOSE_FILE=compose.yaml:net.yaml

DNS_BIND9_ADDRESS=
DNS_BIND9_USER=ubuntu

DNS_PIHOLE_ADDRESS=
DNS_PIHOLE_TZ='America/Guatemala'
DNS_PIHOLE_FTLCONF_webserver_api_password=secret
DNS_PIHOLE_FTLCONF_dns_listeningMode=ALL

NFS_ADDRESS=
NFS_POOL=
NFS_DNS_BIND9_CACHE=
NFS_DNS_BIND9_LIB=
NFS_DNS_BIND9_SRC=
NFS_DNS_PIHOLE=

NGINX_SERVER_ADDRESS=
NGINX_SERVER_WATCH_CRT=/var/local/step
NGINX_SERVER_YAML=/etc/nginx/yaml/servers.yaml

TEMPLATE_DIR=../../templates
TEMPLATE_DNS_BIND9=${TEMPLATE_DIR}/dns/bind9.yaml
TEMPLATE_DNS_PIHOLE=${TEMPLATE_DIR}/dns/pihole.yaml
TEMPLATE_NGINX_SERVER=${TEMPLATE_DIR}/nginx/server.yaml
